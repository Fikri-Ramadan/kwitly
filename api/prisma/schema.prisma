generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password      String?
  emailVerified Boolean     @default(false)
  authTokens    AuthToken[]
  profile       Profile?
  clients       Client[]
  products      Product[]
  invoices      Invoice[]
  createdAt     DateTime    @default(now())
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  company   String?
  phone     String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
}

model Client {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  name            String
  email           String
  phone           String?
  address         String?
  paymentTermDays Int       @default(14)
  paymentMethod   String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  invoices        Invoice[]

  @@unique([userId, email])
}

model Category {
  id        String    @id @default(uuid())
  userId    String
  slug      String
  name      String
  deletedAt DateTime?
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([userId, slug])
}

model Product {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal   @db.Decimal(14, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
}

enum AuthTokenType {
  EMAIL_VERIFY
  MAGIC_LINK
  REFRESH
  FORGOT_PASS
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  familyId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([familyId])
}

model RateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
}

model Invoice {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  number       String //INV-2026-0001
  issueDate    DateTime
  dueDate      DateTime
  status       InvoiceStatus @default(PENDING)
  paymentTerms String?
  notes        String?
  subtotal     Decimal       @db.Decimal(14, 2)
  tax          Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  paidAt       DateTime?
  items        InvoiceItem[]
  // recurring...
  createdAt    DateTime      @default(now())

  @@unique([userId, number])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
}

// recurring...
