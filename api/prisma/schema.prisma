generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  emailVerified Boolean  @default(false)
  verifyToken   String?
  // profile       Profile?
  // clients       Client[]
  // products      Product[]
  // invoices      Invoice[]
  createdAt     DateTime @default(now())
}